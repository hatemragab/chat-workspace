# Generate private local credentials with: node scripts/centrifugo-local.mjs init
# Both NestJS and the launcher read centrifugo/.env. Never commit it.
# Set the absolute path to your locally installed binary.
CENTRIFUGO_BIN=/path/to/centrifugo
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=replace-with-64-random-hex-characters
CENTRIFUGO_API_KEY=replace-with-64-random-hex-characters
CENTRIFUGO_PROXY_SECRET=replace-with-64-random-hex-characters
CENTRIFUGO_API_URL=http://127.0.0.1:9000/api
CENTRIFUGO_ADMIN_PASSWORD=replace-with-a-strong-random-password
CENTRIFUGO_ADMIN_SECRET=replace-with-64-random-hex-characters
CENTRIFUGO_ENGINE_REDIS_ADDRESS=redis://127.0.0.1:6379
# Native CENTRIFUGO_* environment overrides work for all connection limits.
# CENTRIFUGO_CLIENT_USER_CONNECTION_LIMIT=8
# CENTRIFUGO_CLIENT_CONNECTION_LIMIT=1000
# CENTRIFUGO_CLIENT_CONNECTION_RATE_LIMIT=50
# CENTRIFUGO_LOG_LEVEL=debug
# LAN testing only: explicitly set the external listener and configure the Mac firewall.
# CENTRIFUGO_HTTP_SERVER_ADDRESS=192.168.1.10
# The launcher always enforces loopback-only internal endpoints.
