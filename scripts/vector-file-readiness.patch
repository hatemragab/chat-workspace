+#[tokio::test]
+async fn reads_an_appended_important_line_after_long_idle_without_waiting_ten_seconds() {
+    use file_source_common::ReadFrom;
+    use std::io::Write;
+    use std::time::Duration;
+
+    let mut file = tempfile::NamedTempFile::new().unwrap();
+    writeln!(file, "initial-line").unwrap();
+    file.flush().unwrap();
+    let mut watcher = FileWatcher::new(
+        file.path().to_owned(),
+        ReadFrom::Beginning,
+        None,
+        1024,
+        Bytes::from_static(b"\n"),
+    )
+    .await
+    .unwrap();
+    assert!(watcher.read_line().await.unwrap().raw_line.is_some());
+    assert!(watcher.read_line().await.unwrap().raw_line.is_none());
+    watcher.last_read_success = Instant::now() - Duration::from_secs(11);
+    watcher.last_read_attempt = Instant::now() - Duration::from_secs(1);
+    watcher.read_retry_delay = EOF_READ_BACKOFF_MAX;
+    assert!(
+        !watcher.should_read().await,
+        "An unchanged quiet EOF needs no read"
+    );
+    writeln!(file, "important-error").unwrap();
+    file.flush().unwrap();
+    assert!(
+        watcher.should_read().await,
+        "An appended record is ready immediately"
+    );
+    assert_eq!(
+        watcher.read_line().await.unwrap().raw_line.unwrap().bytes,
+        "important-error"
+    );
+}
