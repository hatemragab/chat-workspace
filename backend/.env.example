PORT=3000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/chat_app?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=replace-with-configured-centrifugo-token-secret
CENTRIFUGO_API_URL=http://127.0.0.1:9000/api
CENTRIFUGO_API_KEY=replace-with-configured-centrifugo-api-key
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set false to disable HTTP completion logs; correlation headers remain enabled.
# OPTIONS preflights never produce completion records.
HTTP_LOGGING_ENABLED=true
# Opt in to full HTTP JSON and realtime publish-attempt data for debugging.
# Credentials are redacted; binary files are represented by metadata.
DEBUG_TRAFFIC_LOGGING_ENABLED=false
# Optional output format: pretty (development default), json (other environments), silent.
# Pretty console output is compact; full redacted data stays in optional JSONL files.
# TRAFFIC_LOG_FORMAT=pretty
# Optional append-only private file; unset or off disables file capture.
# Relative paths resolve from the backend process working directory.
# TRAFFIC_LOG_FILE=../.runtime/backend-logs/traffic.jsonl
# Optional metadata-only Redis/MongoDB/Centrifugo client diagnostics.
# Unset or off disables; start:debug supplies the workspace default.
# LOCAL_SERVICE_LOG_FILE=../.runtime/observability/inputs/services.jsonl

# centrifugo/.env takes precedence over this file for dedicated realtime secrets.
# Initialize it once: node ../scripts/centrifugo-local.mjs init
# Online status comes from Centrifugo inbox presence; no application leases/sweeper.
REALTIME_TOKEN_USER_LIMIT=30
REALTIME_TOKEN_IP_LIMIT=120
REALTIME_HEARTBEAT_USER_LIMIT=120
REALTIME_HEARTBEAT_IP_LIMIT=600
REALTIME_STATUS_USER_LIMIT=300
REALTIME_STATUS_IP_LIMIT=1200
# Backend batches Centrifugo snapshots for connected users to retain lastSeenAt.
LAST_SEEN_CHECK_SECONDS=30
# Required only if centrifugo/.env has not been initialized:
# CENTRIFUGO_PROXY_SECRET=replace-with-64-random-hex-characters

# Retryable dependency and post-commit advisory budgets (milliseconds).
REDIS_COMMAND_TIMEOUT_MS=1500
INBOX_FANOUT_CONCURRENCY=8
INBOX_FANOUT_MAX_WAITING=1000
INBOX_FANOUT_DEADLINE_MS=10000
# Keep legacy until every active client supports compact sequenced receipt patches.
RECEIPT_PUSH_MODE=legacy
REALTIME_PUBLISH_TIMEOUT_MS=2500
# Logout always retires credentials first; these quotas bound provider disconnect work only.
REALTIME_LOGOUT_USER_LIMIT=30
REALTIME_LOGOUT_IP_LIMIT=120
# Upload quotas run before Multer allocates a body; concurrency is per backend process.
REALTIME_UPLOAD_USER_LIMIT=30
REALTIME_UPLOAD_IP_LIMIT=120
UPLOAD_MAX_CONCURRENT=4
UPLOAD_MAX_CONCURRENT_PER_USER=2
UPLOAD_REQUEST_TIMEOUT_MS=30000
UPLOAD_MAX_PIXELS=16000000
UPLOAD_MAX_DIMENSION=8192
UPLOAD_MAX_FRAMES=60
# Metadata only: no automatic TTL, removal, or deletion of existing uploads.
UPLOAD_ORPHAN_RETENTION_DAYS=7
# Legacy complete responses fail explicitly above these budgets; opt in to cursor pages.
LEGACY_DIRECTORY_MAX_USERS=10000
LEGACY_PINNED_MAX_ROOMS=1000
